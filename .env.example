# Copy to .env and fill in. Never commit .env.
# AI: "azure" (default when AZURE_OPENAI_ENDPOINT is set), "openai-compatible", or "none".
AI_PROVIDER=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
# Name of a chat model deployment in your Azure resource, e.g. gpt-4o-mini
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Optional: a speech-to-text deployment (whisper or gpt-4o-mini-transcribe). Voice notes are off without it.
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Only for AI_PROVIDER=openai-compatible
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Tag Yoma listings with skills using AI during the daily sync (true/false)
AI_ENRICH_LISTINGS=true
# Local hour (0-23) for the daily Yoma sync
SYNC_HOUR=5
YOMA_API_BASE=https://api.yoma.world/api/v3
# Staff case inbox at /staff (facilitator handoffs and listing reports). Off when empty. Use a long random code.
STAFF_CODE=
# Optional: require this code to open the app (closed pilot). Open http://host/?code=YOURCODE once.
PILOT_ACCESS_CODE=
# AI requests allowed per person (IP address) per 10 minutes
AI_RATE_LIMIT=60
# Set to true when running behind a proxy such as Azure App Service, so each phone gets its own limit
TRUST_PROXY=false
# "Continue with Yoma" sign-in. Needs a Keycloak client for Pathfinder registered by Yoma
# (redirect URI: <PUBLIC_URL>/auth/yoma/callback, audience that the Yoma API accepts). Off when empty.
YOMA_AUTH_ISSUER=https://YOMA-KEYCLOAK-HOST/realms/yoma
YOMA_AUTH_CLIENT_ID=
YOMA_AUTH_CLIENT_SECRET=
# The address people open Pathfinder at, e.g. http://localhost:4173 or https://pathfinder.example.org
PUBLIC_URL=
# Link to the next GenU prototype in the joined-up demo (Phase 3, SkillLens), shown once the plan is saved.
# PathFinder adds ?from=pathfinder&course=…&course_title=…&listing=…&goal=… to it.
NEXT_PROTOTYPE_NAME=SkillLens
NEXT_PROTOTYPE_URL=
# Shared secret for the RapidPro/WhatsApp webhooks (/api/rapidpro/*). Off when empty. Use a long random value.
RAPIDPRO_TOKEN=
# DEMO ONLY. true = when Azure voice is off, use Chrome's built-in speech recognition (audio goes to Google).
# Never turn on for the pilot.
DEMO_BROWSER_VOICE=false
PORT=4173
